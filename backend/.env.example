# --- App ---
ENVIRONMENT=development
AUTH_DISABLED=true
# Production: set AUTH_DISABLED=false and use a random value of at least 32 characters.
ADMIN_API_KEY=
# Optional tenant-scoped dashboard keys: {"key-for-tenant-a":["tenant_object_id"]}
TENANT_API_KEYS_JSON={}
LOG_LEVEL=INFO
PORT=8000

# Comma-separated list of origins allowed to call this API (the frontend's URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://krid-kaws-1.onrender.com
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.onrender\.com

# --- MongoDB Atlas ---
# Get this from Atlas -> Connect -> Drivers -> Python. Use an M0 free-tier cluster.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=whatsapp_saas
ALLOW_IN_MEMORY_DATABASE=true

# --- Gemini ---
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Meta WhatsApp Cloud API ---
# App Secret: Meta App Dashboard -> App Settings -> Basic
META_APP_SECRET=your_meta_app_secret
# Any string you choose — must match what you enter in the Meta webhook config UI
META_WEBHOOK_VERIFY_TOKEN=choose_a_verify_token
# Meta App Dashboard -> WhatsApp -> API Setup -> Temporary/Permanent Access Token
META_ACCESS_TOKEN=your_meta_access_token
# Optional per-phone tokens: {"phone_number_id":"token"}
META_ACCESS_TOKENS_JSON={}
# Meta App Dashboard -> WhatsApp -> API Setup -> Phone Number ID
META_PHONE_NUMBER_ID=your_phone_number_id
META_GRAPH_API_VERSION=v20.0

# --- Typing indicator / handover tuning ---
TYPING_HEARTBEAT_INTERVAL_SECONDS=20
HANDOVER_SENTIMENT_THRESHOLD=0.75
JOB_POLL_INTERVAL_SECONDS=0.5
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
BROADCAST_JOBS_PER_MINUTE=10
